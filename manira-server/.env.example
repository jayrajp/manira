DATABASE_URL=postgresql://postgres:123@Jayraj@localhost:5432/manira_db
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000
ADMIN_CORS_ORIGIN=http://localhost:3001

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=manira-media

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@manira.in
FROM_NAME=Manira Jewels

# Shiprocket
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password
# Optional: pre-generated token from Shiprocket Dashboard → Settings → API (preferred over email/password)
SHIPROCKET_TOKEN=
# Pickup location name (as set in Shiprocket Dashboard → Settings → Manage Warehouses)
SHIPROCKET_PICKUP_LOCATION=Primary
# Pincode of your pickup/warehouse address (for serviceability checks)
SHIPROCKET_PICKUP_PINCODE=380001
# Optional: Shiprocket channel ID for custom store channel
SHIPROCKET_CHANNEL_ID=

# Frontend URLs
FRONTEND_URL=http://localhost:3000
